# HTTP
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=1

# Public URL only used for logs/health metadata. Nginx should terminate HTTPS.
PUBLIC_BASE_URL=https://remote.example.com

# Admin login used by POST /api/admin/login
ADMIN_USER=nextaway
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Optional permanent bearer token for emergency/API access.
# Keep empty if you only want username/password sessions.
ADMIN_TOKEN=

# Session lifetime in hours.
ADMIN_SESSION_HOURS=12

# Storage
DATA_DIR=./data
SEED_CONFIG=./seed-config.json

# Limits
MAX_JSON_BYTES=1048576
MAX_PATCH_BYTES=67108864

# CORS for a future separate admin frontend. Same-origin HTML needs no value here.
# Example: https://panel.example.com,https://remote.example.com
ALLOWED_ORIGINS=
